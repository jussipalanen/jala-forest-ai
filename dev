#!/usr/bin/env bash
# Local development helper for the Docker Compose stack (PostGIS + map app + pgAdmin).
set -euo pipefail

cd "$(dirname "$0")"

DB_SERVICE=postgis
DB_USER=jalaforest
DB_NAME=jalaforest
APP_URL="http://localhost:${APP_PORT:-8501}"
PGADMIN_URL="http://localhost:${PGADMIN_PORT:-5050}"

usage() {
  cat <<'EOF'
Usage: ./dev <command> [args]

Docker:
  up              Build and start PostGIS, the map app and pgAdmin, then wait until they are ready
  down            Stop and remove containers (data volume is kept)
  restart [svc]   Rebuild and force-recreate the containers (all, or postgis/app/pgadmin), then wait
  build           Rebuild the app image
  logs [svc] [-f] Show logs (all services, or postgis/app/pgadmin; -f follows)
  ps              Show container status
  psql [args]     Open psql in the PostGIS container
  dbui            Start pgAdmin and open it in the browser (http://localhost:5050)
  reset           Remove containers AND the data volume (asks for confirmation)

Pipeline, app and tests (run on the host with uv):
  run             Import WFS data, compute overlaps and export GeoParquet
  app             Start the map app on the host instead of Docker (loads .env if present)
  lint            Run ruff
  test            Run unit and integration tests (PostGIS must be up)
  e2e             Run Playwright browser tests (loads .env if present)
  smoke           Build the app image and smoke-test login, robots.txt and /health

Cloud Run:
  deploy [--new-password]  Build, push and deploy to Cloud Run (deploy/cloudrun.sh)
  password        Show the Cloud Run login password
EOF
}

wait_db() {
  # The postgis image restarts the server once after initialising, so require
  # several consecutive successful queries before declaring it ready.
  local ok=0
  for _ in $(seq 1 60); do
    if docker compose exec -T "$DB_SERVICE" psql -U "$DB_USER" -d "$DB_NAME" -tAc "select 1" >/dev/null 2>&1; then
      ok=$((ok + 1))
      if [ "$ok" -ge 3 ]; then
        echo "PostGIS is ready on localhost:${POSTGIS_PORT:-5433}"
        return 0
      fi
    else
      ok=0
    fi
    sleep 1
  done
  echo "PostGIS did not become ready in time; see ./dev logs postgis" >&2
  return 1
}

wait_app() {
  for _ in $(seq 1 60); do
    if curl -sf "$APP_URL/_stcore/health" >/dev/null 2>&1; then
      echo "Map app is ready at $APP_URL"
      [ -f data/export/stand_natura_overlap.parquet ] ||
        echo "Note: no GeoParquet export yet; run ./dev run and reload the page." >&2
      return 0
    fi
    sleep 1
  done
  echo "Map app did not become ready in time; see ./dev logs app" >&2
  return 1
}

remove_stale_containers() {
  # Leftovers named <id>_jalaforest-* from an interrupted recreate block the fixed names.
  local stale
  stale=$(docker ps -aq --filter "name=_jalaforest-" 2>/dev/null || true)
  if [ -n "$stale" ]; then
    echo "Removing stale containers from an interrupted recreate"
    # shellcheck disable=SC2086
    docker rm -f $stale >/dev/null
  fi
}

wait_pgadmin() {
  for _ in $(seq 1 90); do
    if curl -sf "$PGADMIN_URL/misc/ping" >/dev/null 2>&1; then
      echo "pgAdmin is ready at $PGADMIN_URL"
      return 0
    fi
    sleep 1
  done
  echo "pgAdmin did not become ready in time; see ./dev logs pgadmin" >&2
  return 1
}

env_file_args() {
  if [ -f .env ]; then echo "--env-file .env"; fi
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  up)
    mkdir -p data/export
    remove_stale_containers
    docker compose up -d --build --remove-orphans "$@"
    wait_db
    wait_app
    wait_pgadmin
    ;;
  down)
    docker compose down
    ;;
  restart)
    # Force a fresh container: remove the old one first (volumes are kept) instead of
    # --force-recreate, whose rename step fails with fixed container names after an
    # interrupted or concurrent recreate ("container name ... is already in use").
    mkdir -p data/export
    docker compose rm --stop --force "$@"
    remove_stale_containers
    docker compose up -d --build --remove-orphans "$@"
    wait_db
    wait_app
    wait_pgadmin
    ;;
  build)
    docker compose build app
    ;;
  logs)
    docker compose logs "$@"
    ;;
  ps | status)
    docker compose ps
    ;;
  psql)
    docker compose exec "$DB_SERVICE" psql -U "$DB_USER" -d "$DB_NAME" "$@"
    ;;
  dbui)
    docker compose up -d pgadmin >/dev/null
    wait_pgadmin
    if command -v wslview >/dev/null; then wslview "$PGADMIN_URL"
    elif command -v xdg-open >/dev/null; then xdg-open "$PGADMIN_URL" >/dev/null 2>&1 || true
    elif command -v open >/dev/null; then open "$PGADMIN_URL"
    fi
    ;;
  reset)
    read -r -p "This deletes the local PostGIS data volume. Continue? [y/N] " answer
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      docker compose down -v
    else
      echo "Cancelled."
    fi
    ;;
  run)
    uv run jalaforest run "$@"
    ;;
  app)
    # shellcheck disable=SC2046
    uv run $(env_file_args) streamlit run app/streamlit_app.py --server.headless true "$@"
    ;;
  lint)
    uv run ruff check .
    ;;
  test)
    uv run pytest "$@"
    ;;
  e2e)
    # shellcheck disable=SC2046
    uv run $(env_file_args) pytest -m e2e "$@"
    ;;
  smoke)
    docker build -q -t jalaforest-app:local . >/dev/null
    deploy/smoke-test.sh jalaforest-app:local
    ;;
  deploy)
    deploy/cloudrun.sh "$@"
    ;;
  password)
    gcloud secrets versions access latest --secret "${SERVICE:-jalaforest}-basic-auth-password" \
      --project "${PROJECT:-client-jussialanen}"
    echo
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
