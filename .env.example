# Copy to .env (git-ignored) and load with: uv run --env-file .env ...

# AI search switch: true/false (also 1/0, yes/no, on/off). Default: true.
AI_ENABLED=true

# Server-side Gemini API key. Required only when AI_ENABLED=true.
GEMINI_API_KEY=

# Optional: Gemini model. Default: gemini-3.1-flash-lite (lowest-cost model available to new keys).
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: GeoParquet file read by the app.
# DATA_PATH=data/export/stand_natura_overlap.parquet
